{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portable-runtime://contracts/responsibility/bounded-domain-effect-execution-receipt-v1",
  "title": "BoundedDomainEffectExecutionReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "execution_ref",
    "status",
    "work_ref",
    "processed_at",
    "authority_bearing"
  ],
  "properties": {
    "schema": {"const": "bounded-domain-effect-execution-receipt-v1"},
    "execution_ref": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "authorization-rejected",
        "execution-failed",
        "execution-unknown",
        "verified-fail",
        "completed"
      ]
    },
    "work_ref": {"type": "string", "minLength": 1},
    "run_ref": {"type": ["string", "null"]},
    "request_ref": {"type": ["string", "null"]},
    "authorization_ref": {"type": ["string", "null"]},
    "provider_id": {"type": ["string", "null"]},
    "action_ref": {"type": ["string", "null"]},
    "outcome_ref": {"type": ["string", "null"]},
    "evidence_ref": {"type": ["string", "null"]},
    "responsibility_ref": {"type": ["string", "null"]},
    "processed_at": {"type": "string", "format": "date-time"},
    "authority_bearing": {"const": false}
  }
}
