{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portable-runtime://contracts/responsibility/domain-effect-verification-evidence-view-v1",
  "title": "DomainEffectVerificationEvidenceViewV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_ref",
    "action_ref",
    "work_ref",
    "run_ref",
    "objective_result",
    "observed_postcondition",
    "expected_postcondition",
    "verification_request_ref",
    "verification_attempt_ref",
    "verifier_provider_id",
    "verifier_provider_execution_binding_ref",
    "captured_at",
    "authority_bearing"
  ],
  "properties": {
    "schema": {"const": "domain-effect-verification-evidence-view-v1"},
    "evidence_ref": {"type": "string", "minLength": 1},
    "action_ref": {"type": "string", "minLength": 1},
    "work_ref": {"type": "string", "minLength": 1},
    "run_ref": {"type": "string", "minLength": 1},
    "objective_result": {"enum": ["pass", "fail"]},
    "observed_postcondition": {"type": "object"},
    "expected_postcondition": {"type": "object"},
    "verification_request_ref": {"type": "string", "minLength": 1},
    "verification_attempt_ref": {"type": "string", "minLength": 1},
    "verifier_provider_id": {"type": "string", "minLength": 1},
    "verifier_provider_execution_binding_ref": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "authority_bearing": {"const": false}
  }
}
