{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portable-runtime://contracts/responsibility/bounded-domain-effect-execution-v1",
  "title": "BoundedDomainEffectExecutionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "work_ref",
    "domain_intent_ref",
    "domain_grant_ref",
    "governance_basis_ref",
    "approval_satisfaction_ref",
    "capability",
    "subject_ref",
    "authority_epoch",
    "parameters",
    "expected_postcondition",
    "observed_at"
  ],
  "properties": {
    "schema": {"const": "bounded-domain-effect-execution-v1"},
    "work_ref": {"type": "string", "minLength": 1},
    "domain_intent_ref": {"type": "string", "minLength": 1},
    "domain_grant_ref": {"type": "string", "minLength": 1},
    "governance_basis_ref": {"type": "string", "minLength": 1},
    "approval_satisfaction_ref": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "subject_ref": {"type": "string", "minLength": 1},
    "authority_epoch": {"type": "integer", "minimum": 0},
    "parameters": {"type": "object"},
    "expected_postcondition": {"type": "object"},
    "observed_at": {"type": "string", "format": "date-time"}
  }
}
